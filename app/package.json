{
  "name": "@itonami/tawami-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "itonami": {
    "id": "network.itonami.tawami",
    "title": "Tawami",
    "storageKey": "itonami.tawami.v1",
    "description": "撓 — 電力の柔軟性（時間をずらせる力）を、この端末で見積もります。蓄電池や EV などの資産を入力すると、応答の速さ・ずらせる量・柔軟性の価値と区分を計算します。指令や取引はせず、外部へは何も送信しません。",
    "cljsSources": [
      "../src"
    ],
    "storeId": "network.itonami.tawami"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "tauri": "tauri",
    "build:desktop": "npm run build && tauri build --no-bundle",
    "build:android": "sh scripts/android-apk.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.6"
  }
}
